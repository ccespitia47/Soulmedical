# ── Variables del frontend (Vite) ─────────────────────────────────────────────
# Cópialo a `.env` y ajusta los hosts según tu entorno.

# URL del backend NestJS (auth, usuarios, proyectos, formularios, etc.)
# El cliente añade los endpoints con prefijo `/api/...`
VITE_API_URL=http://localhost:3001

# URL del microservicio Express que envía emails vía Microsoft Graph
# El cliente llama a `${VITE_EMAIL_SERVICE_URL}/api/send-email`
VITE_EMAIL_SERVICE_URL=http://localhost:3003
