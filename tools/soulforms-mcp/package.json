{
  "name": "soulforms-mcp",
  "version": "0.1.0",
  "description": "MCP server for creating SoulForms forms programmatically from Claude Code",
  "type": "module",
  "private": true,
  "bin": {
    "soulforms-mcp": "./dist/server.js"
  },
  "scripts": {
    "start": "node --import tsx ./src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
