# ── Base de datos (PostgreSQL para tabla users) ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=soulformsdb

# ── MongoDB (todo lo demás: folders, forms, submissions, etc.) ────────────────
MONGO_URI=mongodb://localhost:27017/soulformsdb

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=soulforms-jwt-secret-cambiar-en-produccion
JWT_EXPIRES_IN=30m

# ── CORS y servidor ───────────────────────────────────────────────────────────
# Múltiples orígenes separados por coma. También se acepta cualquier IP LAN/localhost.
FRONTEND_ORIGIN=http://localhost:5173

# Puerto del backend NestJS
PORT=3001

# URL base del frontend para construir links (p. ej. reset password)
APP_BASE_URL=http://localhost:5173

# ── Microsoft Graph (envío de emails desde el módulo EmailModule) ─────────────
# Requeridas si activas notificaciones por email o reset password.
# Configurar una App Registration en Azure AD con permisos Mail.Send (Application).
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
SENDER_EMAIL=