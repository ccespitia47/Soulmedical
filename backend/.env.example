# Configuración de Base de Datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=soulformsdb

# JWT
JWT_SECRET=soulforms-jwt-secret-cambiar-en-produccion
JWT_EXPIRES_IN=30m

# Origen del frontend que puede llamar al backend
FRONTEND_ORIGIN=http://localhost:5173

# Puerto del servidor
PORT=3001
